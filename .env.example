# ═══════════════════════════════════════════════════════════════════════
#  BrightMinds — environment variables
#
#  LOCAL:  copy this file to `.env` and fill in the values.
#  VERCEL: add every one of these under
#          Project → Settings → Environment Variables (Production + Preview),
#          then redeploy. Vite only bakes in VITE_* vars at BUILD time, so a
#          redeploy is required after changing any of them.
#
#  ⚠ Never commit the filled-in `.env` — it is git-ignored for a reason.
# ═══════════════════════════════════════════════════════════════════════


# ── 1. Firebase — browser SDK (safe to expose; restricted by Firebase rules) ──
# Firebase console → Project settings → General → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ── 2. Firebase Admin — server only. NEVER prefix these with VITE_ ────────────
# Firebase console → Project settings → Service accounts
#   → "Generate new private key" → download the JSON.
# Copy the three values out of that JSON file.
# In FIREBASE_PRIVATE_KEY keep the \n escapes exactly as they appear, and wrap
# the whole value in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# Alternative to the three above: the whole service-account JSON, raw or base64.
# FIREBASE_SERVICE_ACCOUNT_JSON=


# ── 3. Razorpay ───────────────────────────────────────────────────────────────
# Razorpay Dashboard → Account & Settings → API Keys → Generate Key.
# Start with the TEST keys (rzp_test_...), switch to LIVE after testing.
# Only the key ID is sent to the browser; the secret stays on the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks → Add New Webhook
#   URL     : https://brightmindsclasses.in/api/razorpay-webhook
#   Events  : payment.captured, payment.failed, order.paid
#   Secret  : any strong random string — paste the SAME value here.
RAZORPAY_WEBHOOK_SECRET=


# ── 4. Email (Resend) ─────────────────────────────────────────────────────────
# Drives three emails:
#   - student receipt + WhatsApp link, on payment
#   - admin alert on every enrolment, WITH the student spreadsheet attached
#   - admin alert the first time a new student signs in
# resend.com → API Keys. Verify your domain to send from @brightmindsclasses.in;
# until then leave RESEND_FROM_EMAIL on the onboarding@resend.dev default.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BrightMinds <noreply@brightmindsclasses.in>"
ADMIN_EMAIL=hello@brightmindsclasses.in


# ── 5. WhatsApp community ─────────────────────────────────────────────────────
# WhatsApp → your community/group → Invite link → Copy link.
# Server-side only. Never add a VITE_ copy: that would compile the invite into
# the public bundle and let anyone join without paying.
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/XXXXXXXXXXXXXXX


# ── 6. Site & admin ───────────────────────────────────────────────────────────
SITE_URL=https://brightmindsclasses.in
# Who can open /admin. Comma-separated. Keep identical to adminEmails() in
# firestore.rules, otherwise the page loads but Firestore refuses the read.
VITE_ADMIN_EMAILS=khannaamar001@gmail.com,hello@brightmindsclasses.in

# Extra origins allowed to call the API (comma-separated). Optional — the
# production and localhost origins are allowed by default.
# ALLOWED_ORIGINS=

# Only needed if the API is hosted somewhere other than the website itself.
# VITE_API_BASE_URL=


# ── 7. Existing enquiry-form integration (unchanged) ──────────────────────────
# VITE_APPS_SCRIPT_URL=
