# Resend API Key
# Get yours at resend.com -> API Keys. Never commit the real value.
RESEND_API_KEY=

# Admin email where form submissions will be sent
ADMIN_EMAIL=hello@brightmindsclasses.in

# Optional: Custom "From" email (from Resend verified domain)
RESEND_FROM_EMAIL=noreply@brightmindsclasses.in

# Server port
PORT=3001
